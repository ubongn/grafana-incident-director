# ============================================================
# Grafana Incident Director — environment template
# Copy to .env and fill in real values. NEVER commit .env.
# ============================================================

# --- Gemini (Google AI Studio key: https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.6-flash

# --- Vertex AI (optional) ---
# TODO(gcp): once the Google Cloud project is provisioned (~Aug 30), flip the
# provider layer to Vertex AI by setting the following and leaving
# GEMINI_API_KEY empty. The model provider in agent/src/models/ is swappable
# by design: one interface, two backends (AI Studio today, Vertex AI at submit).
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=us-central1

# --- Grafana ---
GRAFANA_URL=http://localhost:3001
# Service account token created in Grafana: Administration > Service accounts
GRAFANA_SERVICE_ACCOUNT_TOKEN=your-grafana-service-account-token

# --- Agent runtime ---
AGENT_PORT=8787
AGENT_LOG_LEVEL=info

# --- Telemetry simulator ---
SIM_CONTROL_URL=http://localhost:8790
PROMETHEUS_REMOTE_WRITE_URL=http://localhost:9090/api/v1/write
LOKI_PUSH_URL=http://localhost:3100/loki/api/v1/push

# --- Grafana Cloud mode (sim -> hosted Prometheus/Loki) ---
# Flip the two *_URL values to your stack's hosted endpoints and set the
# basic-auth pair below + SIM_CARDINALITY=cloud (free-tier-safe cardinality).
# PROM_USERNAME / LOKI_USERNAME are the numeric instance ids shown next to
# each hosted data source in Grafana Cloud; GRAFANA_CLOUD_API_KEY is an
# access-policy token (glc_...) with metrics+logs read/write scope.
# PROMETHEUS_REMOTE_WRITE_URL=https://prometheus-prod-XX-prod-<region>.grafana.net/api/prom/push
# PROM_USERNAME=0000000
# LOKI_PUSH_URL=https://logs-prod-XXX.grafana.net/loki/api/v1/push
# LOKI_USERNAME=0000001
# GRAFANA_CLOUD_API_KEY=your-glc-cloud-access-policy-token
# SIM_CARDINALITY=cloud
# SIM_JOB_LABEL=hiclaw-sim
# TICK_MS=5000
# ---
# Pointing the AGENT at Grafana Cloud instead of local: set GRAFANA_URL to the
# stack URL (https://<stack>.grafana.net) and GRAFANA_SERVICE_ACCOUNT_TOKEN to
# a service-account token (glsa_...). deploy\run-cloud-arc.cmd does exactly
# this from a staged creds file.
