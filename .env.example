# ============================================================
# Grafana Incident Director — environment template
# Copy to .env and fill in real values. NEVER commit .env.
# ============================================================

# --- Gemini (Google AI Studio key: https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.6-flash

# --- Vertex AI (optional) ---
# TODO(gcp): once the Google Cloud project is provisioned (~Aug 30), flip the
# provider layer to Vertex AI by setting the following and leaving
# GEMINI_API_KEY empty. The model provider in agent/src/models/ is swappable
# by design: one interface, two backends (AI Studio today, Vertex AI at submit).
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=us-central1

# --- Grafana ---
GRAFANA_URL=http://localhost:3001
# Service account token created in Grafana: Administration > Service accounts
GRAFANA_SERVICE_ACCOUNT_TOKEN=your-grafana-service-account-token

# --- Agent runtime ---
AGENT_PORT=8787
AGENT_LOG_LEVEL=info

# --- Telemetry simulator ---
SIM_CONTROL_URL=http://localhost:8790
PROMETHEUS_REMOTE_WRITE_URL=http://localhost:9090/api/v1/write
LOKI_PUSH_URL=http://localhost:3100/loki/api/v1/push
